    {
      "type": "table",
      "title": "Trazas con error o lentas",
      "description": "Aquí se salta del agregado a UNA petición concreta. Pulsa un TraceId para abrirla.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "argus-trazas"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "argus-trazas"
          },
          "refId": "A",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT Timestamp, ServiceName AS componente, SpanName AS operacion,\n       round(Duration / 1e6) AS ms,\n       SpanAttributes['error.type'] AS error, TraceId\nFROM otel.otel_traces\nWHERE ResourceAttributes['service.namespace'] = '$app'\n  AND $__timeFilter(Timestamp)\n  AND (StatusCode = 'STATUS_CODE_ERROR' OR Duration > 1e9)\nORDER BY Timestamp DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "#fab219",
                      "value": 1000
                    },
                    {
                      "color": "#d03b3b",
                      "value": 5000
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Timestamp",
            "desc": true
          }
        ]
      }
