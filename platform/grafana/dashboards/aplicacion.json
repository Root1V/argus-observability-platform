{
  "uid": "argus-aplicacion",
  "title": "Argus · una aplicación",
  "description": "Responde «¿cómo va mi aplicación?». Elige una en el selector de arriba.\n\nPara «¿qué pasó en esta petición concreta?», pulsa un TraceId de la tabla del final: esa es otra pregunta y se responde en la vista de trazas.",
  "tags": [
    "argus"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Aplicación",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "argus-metricas"
        },
        "refresh": 1,
        "query": {
          "query": "label_values(traces_span_metrics_calls_total, service_namespace)",
          "refId": "A"
        },
        "current": {},
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Estado ahora",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Peticiones / min",
      "description": "Throughput de toda la aplicación, sumando sus componentes.",
      "datasource": {
        "type": "prometheus",
        "uid": "argus-metricas"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "argus-metricas"
          },
          "expr": "sum(rate(traces_span_metrics_calls_total{service_namespace=\"$app\"}[5m])) * 60",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Tasa de error",
      "description": "Verde bajo el 1%, ámbar hasta el 5%, rojo por encima.",
      "datasource": {
        "type": "prometheus",
        "uid": "argus-metricas"
