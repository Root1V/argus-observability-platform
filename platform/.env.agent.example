# Configuracion del Collector agente. Copia a `.env.agent` en cada maquina.

# Nombre ESTABLE del plano central. Con una red privada tipo Tailscale obtienes
# un nombre que sobrevive a cambios de red y a mover el servicio de maquina.
# Evita las IP: una IP convierte "migrar el plano central" en "reconfigurar
# todos los agentes".
ARGUS_GATEWAY_ENDPOINT=argus.tu-tailnet.ts.net:4317

# El alert-bus recibe el CAMINO CALIENTE (errores y SLO roto) y es un receptor
# OTLP. Si aun no existe, dejalo apuntando al gateway: la deteccion en tiempo
# real llegara con la Fase 2.
ARGUS_ALERTBUS_ENDPOINT=argus.tu-tailnet.ts.net:4317

# El MISMO token que el gateway.
ARGUS_GATEWAY_TOKEN=

# `true` mientras el transporte vaya por una red privada cifrada (WireGuard ya
# cifra). Ponlo a `false` y configura TLS si la telemetria sale a internet.
ARGUS_INSECURE=true
