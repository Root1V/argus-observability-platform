# Configuracion del Collector AGENTE de una maquina.
#
# Copia este fichero a `.env.agent` y rellena los valores. El real NUNCA
# va al repositorio: contiene el token que autoriza a inyectar telemetria,
# y quien lo tenga puede escribir en el almacen del que los agentes sacan
# sus conclusiones.
#
# Estuvo versionado desde el commit 78918b9 hasta el 15/09/2026 (D-066).

ARGUS_GATEWAY_ENDPOINT=<argus_gateway_endpoint>
ARGUS_ALERTBUS_ENDPOINT=<argus_alertbus_endpoint>
ARGUS_GATEWAY_TOKEN=<argus_gateway_token>
ARGUS_INSECURE=true
