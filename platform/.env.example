# Copia a `.env` y rellena. El `.env` NUNCA se commitea.
# Genera los secretos con:  openssl rand -hex 32

CLICKHOUSE_USER=argus
CLICKHOUSE_PASSWORD=

# Token del endpoint OTLP. La red privada protege el transporte; este token
# evita que cualquier proceso de una maquina autorizada inyecte telemetria
# falsa. Con agentes de IA leyendo esto y sacando conclusiones, la integridad
# de lo que entra importa.
ARGUS_GATEWAY_TOKEN=

# --- Perfil genai ---
LANGFUSE_DB_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
MINIO_USER=argus
MINIO_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_URL=http://localhost:3000
# Basic base64("<public_key>:<secret_key>"), de un proyecto de Langfuse.
# Se rellena DESPUES de crear el proyecto en su UI.
ARGUS_LANGFUSE_AUTH=

# --- Perfil agents ---
TEMPORAL_DB_PASSWORD=
