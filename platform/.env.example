# Copia a `.env` y rellena. El `.env` NUNCA se commitea.
# Genera los secretos con:  openssl rand -hex 32

CLICKHOUSE_USER=argus
CLICKHOUSE_PASSWORD=

# Token del endpoint OTLP. La red privada protege el transporte; este token
# evita que cualquier proceso de una maquina autorizada inyecte telemetria
# falsa. Con agentes de IA leyendo esto y sacando conclusiones, la integridad
# de lo que entra importa.
ARGUS_GATEWAY_TOKEN=

# --- Perfil genai ---
LANGFUSE_DB_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
MINIO_USER=argus
MINIO_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_URL=http://localhost:3000
# Basic base64("<public_key>:<secret_key>"), de un proyecto de Langfuse.
# Se rellena DESPUES de crear el proyecto en su UI.
ARGUS_LANGFUSE_AUTH=

# --- Perfil agents ---
TEMPORAL_DB_PASSWORD=

# --- Canales de notificacion (F2-04) ---
# Cada uno se omite con un aviso si no esta configurado.
#
# Google Chat es el canal principal: un POST con JSON, sin aprobacion de
# proveedor, sin coste por mensaje, y el unico con botones.
ALERTBUS_SINKS=console,json
ALERTBUS_GCHAT_WEBHOOK=

# Correo: el informe COMPLETO, sin limite de longitud ni urgencia.
ALERTBUS_SMTP_HOST=
ALERTBUS_SMTP_PORT=587
ALERTBUS_SMTP_USER=
ALERTBUS_SMTP_PASSWORD=
ALERTBUS_SMTP_FROM=argus@localhost
ALERTBUS_SMTP_TO=

# WhatsApp: SOLO critico fuera de horario. Cuesta por mensaje y exige plantilla
# preaprobada; clasificala como `utility`, no como `marketing`.
ALERTBUS_WHATSAPP_PHONE_ID=
ALERTBUS_WHATSAPP_TOKEN=
ALERTBUS_WHATSAPP_TO=
ALERTBUS_WHATSAPP_TEMPLATE=argus_incidente

# --- Canario (F2-06) ---
CANARY_INTERVALO_S=300

# --- Dashboards ---
# Grafana en http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Langfuse (perfil genai) ---
# Se provisionan al arrancar: no hay que crear el proyecto por la UI.
# ARGUS_LANGFUSE_AUTH es base64("<public>:<secret>") y lo usa el Collector.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_EMAIL=argus@argus.local
LANGFUSE_INIT_PASSWORD=
ARGUS_LANGFUSE_AUTH=
