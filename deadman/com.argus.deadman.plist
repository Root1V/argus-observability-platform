<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tarea de launchd para el dead man's switch en macOS.

  Corre FUERA de Docker a proposito: un vigilante dentro del contenedor que
  vigila se cae con el.

  Instalacion:
    1. Ajusta las rutas absolutas de abajo.
    2. cp deadman/com.argus.deadman.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.argus.deadman.plist
    4. Comprueba que puede avisarte:
         python3 deadman/deadman.py --config deadman/deadman.json --test

  Comprobar que sigue activo:
    launchctl list | grep argus
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.argus.deadman</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/RUTA/ABSOLUTA/A/app_monitoring_explainability/deadman/deadman.py</string>
    <string>--config</string>
    <string>/RUTA/ABSOLUTA/A/app_monitoring_explainability/deadman/deadman.json</string>
  </array>

  <!-- Cada 5 minutos. Mas frecuente no compra nada: hacen falta dos fallos
       consecutivos para avisar, asi que el peor caso son 10 minutos hasta el
       aviso, que para "la plataforma entera esta caida" es razonable. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/argus-deadman.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/argus-deadman.err</string>
</dict>
</plist>
